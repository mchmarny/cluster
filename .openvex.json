    {
      "vulnerability": {
        "name": "GHSA-jp4c-xjxw-mgf9",
        "description": "pip < 26.1 vulnerability bundled inside the gcloud SDK's vendored Python site-packages. gcloud manages its own bundled pip and does not allow user upgrade via OS package manager."
      },
      "products": [
        { "@id": "pkg:oci/cluster-gke", "identifiers": { "purl": "pkg:oci/cluster-gke" } }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "The gcloud-bundled pip is only used internally by `gcloud components` to install gke-gcloud-auth-plugin at image build time (image/gke.dockerfile line ~74). It is never invoked at runtime with attacker-controlled package URLs or indices. The cluster runtime never calls `gcloud components` again; pip's vulnerable code paths are unreachable."
    },
    {
      "vulnerability": {
        "name": "GHSA-58qw-9mgm-455v",
        "description": "pip < 26.1 vulnerability bundled inside gcloud SDK's vendored Python site-packages."
