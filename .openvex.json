  "statements": [
    {
      "vulnerability": {
        "name": "CVE-2026-7210",
        "description": "cpython xml.parsers.expat / xml.etree.ElementTree insufficient entropy for Expat hash-flooding protection (CWE-331, Critical). Fix not yet backported to Python 3.14.x; appears in vendored Python inside the gcloud SDK and AWS CLI v2 bundles."
      },
      "products": [
        { "@id": "pkg:oci/cluster-eks", "identifiers": { "purl": "pkg:oci/cluster-eks" } },
        { "@id": "pkg:oci/cluster-gke", "identifiers": { "purl": "pkg:oci/cluster-gke" } }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "The vulnerability requires parsing attacker-controlled XML through xml.parsers.expat / xml.etree.ElementTree. The vendored CPython interpreter is only invoked transitively by two CLIs: (1) gcloud SDK (image/gke.dockerfile), used by tools/common to authenticate to GCP and pull cluster credentials — these calls speak HTTPS+JSON/protobuf to Google APIs, not XML; (2) AWS CLI v2 (image/eks.dockerfile), used by tools/common to talk to STS/EKS — also JSON-over-HTTPS. The cluster Go binary does not invoke these CLIs with attacker-supplied arguments. There is no code path in this image that feeds untrusted XML to the bundled Python's expat parser."
    },
    {
      "vulnerability": {
        "name": "CVE-2025-15366",
        "description": "cpython 3.14.x — fix landed only in 3.15.0a6; cannot be upgraded within the 3.14.x vendored runtime shipped with gcloud SDK and AWS CLI v2."
      },
      "products": [
        { "@id": "pkg:oci/cluster-eks", "identifiers": { "purl": "pkg:oci/cluster-eks" } },
        { "@id": "pkg:oci/cluster-gke", "identifiers": { "purl": "pkg:oci/cluster-gke" } }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "Same Python-in-CLI surface as CVE-2026-7210. The vendored Python interpreter is only entered through gcloud / aws CLI invocations made by the cluster binary, with arguments derived from validated YAML configuration. No attacker-controlled input crosses the boundary into the Python runtime."
    },
