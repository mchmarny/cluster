        { "@id": "pkg:oci/cluster-gke", "identifiers": { "purl": "pkg:oci/cluster-gke" } }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "Same reachability as GHSA-jp4c-xjxw-mgf9: the bundled pip is only invoked at image build time by `gcloud components install` and is never re-entered at runtime."
    },
    {
      "vulnerability": {
        "name": "GO-2026-5026",
        "description": "golang.org/x/net vulnerability (Critical) statically linked into the upstream HashiCorp `terraform` binary. The official terraform binary is downloaded prebuilt from releases.hashicorp.com — its dependency versions are pinned by HashiCorp and cannot be upgraded without rebuilding terraform from source."
      },
      "products": [
        { "@id": "pkg:oci/cluster-eks", "identifiers": { "purl": "pkg:oci/cluster-eks" } },
        { "@id": "pkg:oci/cluster-gke", "identifiers": { "purl": "pkg:oci/cluster-gke" } }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "The vulnerable golang.org/x/net version is vendored into the terraform binary, not into the cluster Go binary (cluster's go.mod has no x/net dependency — verified with `go list -m all`). terraform is invoked with a fixed, operator-controlled CONFIG_PATH and TF_VAR_CONFIG_PATH (pkg/terraform/terraform.go) against AWS/GCP API endpoints over HTTPS — no attacker-controlled hosts or HTTP/2 frames cross terraform's network boundary in this image."
    },
