#!/bin/bash

set -euo pipefail

# Paths
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${DIR}/common"

# Check for required tools
REQUIRED_TOOLS=(aws kubectl jq yq)
has_tools "${REQUIRED_TOOLS[@]}"

# Config
CONFIG_FILE="${1:-}"
if [[ -z "$CONFIG_FILE" ]]; then
  err "Usage: $0 <path to config.yaml>"
fi
if [[ ! -f "$CONFIG_FILE" ]]; then
  err "Config file does not exist: ${CONFIG_FILE}"
fi

# Parse config
CLUSTER_NAME="$(yq -er '.cluster.name' "$CONFIG_FILE")"
REGION="$(yq -er '.deployment.location' "$CONFIG_FILE")"
ACCOUNT_ID="$(yq -er '.deployment.tenancy' "$CONFIG_FILE")"
EXPECTED_VERSION="$(yq -er '.cluster.version' "$CONFIG_FILE")"

msg "Validating cluster: ${CLUSTER_NAME} in ${REGION}"

FAILED=0
PASSED=0

# Helper function to check a condition
check() {
  local name="$1"
  local condition="$2"
  if eval "$condition"; then
    msg "PASS: $name"
    PASSED=$((PASSED + 1))
  else
    printf "${COLOR_RED}[FAIL]${COLOR_RESET} $name\n" >&2
    FAILED=$((FAILED + 1))
  fi
}

# =============================================================================
# EKS Cluster Validation
# =============================================================================
msg "Checking EKS cluster..."

CLUSTER_INFO=$(aws eks describe-cluster --name "$CLUSTER_NAME" --region "$REGION" --output json 2>/dev/null || echo "{}")

if [[ "$CLUSTER_INFO" == "{}" ]]; then
  err "Cluster '$CLUSTER_NAME' not found in region '$REGION'"
fi

CLUSTER_STATUS=$(echo "$CLUSTER_INFO" | jq -r '.cluster.status')
CLUSTER_VERSION=$(echo "$CLUSTER_INFO" | jq -r '.cluster.version')
SERVICE_CIDR=$(echo "$CLUSTER_INFO" | jq -r '.cluster.kubernetesNetworkConfig.serviceIpv4Cidr')
CLUSTER_ENDPOINT=$(echo "$CLUSTER_INFO" | jq -r '.cluster.endpoint')

check "Cluster status is ACTIVE" "[[ '$CLUSTER_STATUS' == 'ACTIVE' ]]"
check "Cluster version starts with $EXPECTED_VERSION" "[[ '$CLUSTER_VERSION' == $EXPECTED_VERSION* ]]"
check "Service CIDR is configured" "[[ -n '$SERVICE_CIDR' && '$SERVICE_CIDR' != 'null' ]]"
check "Cluster endpoint is configured" "[[ -n '$CLUSTER_ENDPOINT' && '$CLUSTER_ENDPOINT' != 'null' ]]"

# =============================================================================
# VPC Validation
# =============================================================================
msg "Checking VPC configuration..."

VPC_ID=$(echo "$CLUSTER_INFO" | jq -r '.cluster.resourcesVpcConfig.vpcId')
check "VPC ID is set" "[[ -n '$VPC_ID' && '$VPC_ID' != 'null' ]]"

SUBNET_COUNT=$(aws ec2 describe-subnets --filters "Name=vpc-id,Values=$VPC_ID" --region "$REGION" --query 'length(Subnets)' --output text 2>/dev/null || echo "0")
check "VPC has subnets (expected >= 4)" "[[ $SUBNET_COUNT -ge 4 ]]"

# Check for required subnet types
PUBLIC_SUBNETS=$(aws ec2 describe-subnets --filters "Name=vpc-id,Values=$VPC_ID" "Name=tag:Name,Values=*public*" --region "$REGION" --query 'length(Subnets)' --output text 2>/dev/null || echo "0")
SYSTEM_SUBNETS=$(aws ec2 describe-subnets --filters "Name=vpc-id,Values=$VPC_ID" "Name=tag:Name,Values=*system*" --region "$REGION" --query 'length(Subnets)' --output text 2>/dev/null || echo "0")
WORKER_SUBNETS=$(aws ec2 describe-subnets --filters "Name=vpc-id,Values=$VPC_ID" "Name=tag:Name,Values=*worker*" --region "$REGION" --query 'length(Subnets)' --output text 2>/dev/null || echo "0")
POD_SUBNETS=$(aws ec2 describe-subnets --filters "Name=vpc-id,Values=$VPC_ID" "Name=tag:Name,Values=*pod*" --region "$REGION" --query 'length(Subnets)' --output text 2>/dev/null || echo "0")

check "Public subnets exist (expected >= 2)" "[[ $PUBLIC_SUBNETS -ge 2 ]]"
check "System subnets exist (expected >= 2)" "[[ $SYSTEM_SUBNETS -ge 2 ]]"
check "Worker subnets exist (expected >= 2)" "[[ $WORKER_SUBNETS -ge 2 ]]"
check "Pod subnets exist (expected >= 2)" "[[ $POD_SUBNETS -ge 2 ]]"

# =============================================================================
# VPC Endpoints Validation
# =============================================================================
msg "Checking VPC endpoints..."

ENDPOINTS=$(aws ec2 describe-vpc-endpoints --filters "Name=vpc-id,Values=$VPC_ID" --region "$REGION" --query 'VpcEndpoints[*].{Service:ServiceName,State:State}' --output json 2>/dev/null || echo "[]")
ENDPOINT_COUNT=$(echo "$ENDPOINTS" | jq 'length')

check "VPC endpoints exist (expected >= 5)" "[[ $ENDPOINT_COUNT -ge 5 ]]"

# Check each required endpoint
for SERVICE in s3 ssm ssmmessages ec2messages logs; do
  STATE=$(echo "$ENDPOINTS" | jq -r ".[] | select(.Service | contains(\"$SERVICE\")) | .State" | head -1)
  check "VPC endpoint $SERVICE is available" "[[ '$STATE' == 'available' ]]"
done

# =============================================================================
# Node Validation
# =============================================================================
msg "Checking nodes..."

# Update kubeconfig
aws eks update-kubeconfig --region "$REGION" --name "$CLUSTER_NAME" --alias "$CLUSTER_NAME" >/dev/null 2>&1

NODE_COUNT=$(kubectl get nodes --no-headers 2>/dev/null | wc -l | tr -d ' ')
READY_NODES=$(kubectl get nodes --no-headers 2>/dev/null | grep -c " Ready " || echo "0")

# Get expected node count from config (system nodes desired capacity)
EXPECTED_NODES=$(yq -er '.compute.nodeGroups.system.capacity.desired // 3' "$CONFIG_FILE")

check "Nodes exist (expected >= $EXPECTED_NODES)" "[[ $NODE_COUNT -ge $EXPECTED_NODES ]]"
check "All nodes are Ready" "[[ $READY_NODES -eq $NODE_COUNT ]]"

# Check node taints
TAINTED_NODES=$(kubectl get nodes -o json 2>/dev/null | jq '[.items[].spec.taints[]? | select(.key == "dedicated")] | length')
check "System nodes have dedicated taint" "[[ $TAINTED_NODES -gt 0 ]]"

# =============================================================================
# Autoscaling Group Validation
# =============================================================================
msg "Checking autoscaling groups..."

DEPLOYMENT_ID="$(yq -er '.deployment.id' "$CONFIG_FILE")"
ASG_NAME="${DEPLOYMENT_ID}-system"

ASG_INFO=$(aws autoscaling describe-auto-scaling-groups --auto-scaling-group-names "$ASG_NAME" --region "$REGION" --output json 2>/dev/null || echo '{"AutoScalingGroups":[]}')
ASG_EXISTS=$(echo "$ASG_INFO" | jq '.AutoScalingGroups | length')

check "System ASG exists" "[[ $ASG_EXISTS -gt 0 ]]"

if [[ $ASG_EXISTS -gt 0 ]]; then
  ASG_DESIRED=$(echo "$ASG_INFO" | jq -r '.AutoScalingGroups[0].DesiredCapacity')
  ASG_AZ_COUNT=$(echo "$ASG_INFO" | jq '.AutoScalingGroups[0].AvailabilityZones | length')
  check "ASG desired capacity matches config ($EXPECTED_NODES)" "[[ $ASG_DESIRED -eq $EXPECTED_NODES ]]"
  check "ASG spans multiple AZs (expected >= 2)" "[[ $ASG_AZ_COUNT -ge 2 ]]"
fi

# =============================================================================
# ENI Config Validation (Custom Networking)
# =============================================================================
msg "Checking custom networking (ENI configs)..."

ENICONFIG_COUNT=$(kubectl get eniconfigs --no-headers 2>/dev/null | wc -l | tr -d ' ' || echo "0")
check "ENI configs exist (expected >= 2)" "[[ $ENICONFIG_COUNT -ge 2 ]]"

# =============================================================================
# Core Components Validation
# =============================================================================
msg "Checking core components..."

# Check VPC CNI (aws-node)
AWS_NODE_PODS=$(kubectl get pods -n kube-system -l k8s-app=aws-node --no-headers 2>/dev/null | grep -c "Running" || echo "0")
check "VPC CNI pods running (expected >= $NODE_COUNT)" "[[ $AWS_NODE_PODS -ge $NODE_COUNT ]]"

# Check kube-proxy
KUBE_PROXY_PODS=$(kubectl get pods -n kube-system -l k8s-app=kube-proxy --no-headers 2>/dev/null | grep -c "Running" || echo "0")
check "kube-proxy pods running (expected >= $NODE_COUNT)" "[[ $KUBE_PROXY_PODS -ge $NODE_COUNT ]]"

# =============================================================================
# Security Groups Validation
# =============================================================================
msg "Checking security groups..."

SG_SYSTEM=$(aws ec2 describe-security-groups --filters "Name=vpc-id,Values=$VPC_ID" "Name=tag:Name,Values=*system*" --region "$REGION" --query 'length(SecurityGroups)' --output text 2>/dev/null || echo "0")
SG_WORKER=$(aws ec2 describe-security-groups --filters "Name=vpc-id,Values=$VPC_ID" "Name=tag:Name,Values=*worker*" --region "$REGION" --query 'length(SecurityGroups)' --output text 2>/dev/null || echo "0")

check "System security group exists" "[[ $SG_SYSTEM -ge 1 ]]"
check "Worker security group exists" "[[ $SG_WORKER -ge 1 ]]"

# =============================================================================
# IAM Validation
# =============================================================================
msg "Checking IAM roles..."

EKS_ROLE=$(aws iam get-role --role-name "${DEPLOYMENT_ID}-eks" --query 'Role.RoleName' --output text 2>/dev/null || echo "")
SYSTEM_ROLE=$(aws iam get-role --role-name "${DEPLOYMENT_ID}-system-nodes" --query 'Role.RoleName' --output text 2>/dev/null || echo "")
WORKER_ROLE=$(aws iam get-role --role-name "${DEPLOYMENT_ID}-worker-nodes" --query 'Role.RoleName' --output text 2>/dev/null || echo "")

check "EKS cluster role exists" "[[ -n '$EKS_ROLE' ]]"
check "System nodes role exists" "[[ -n '$SYSTEM_ROLE' ]]"
check "Worker nodes role exists" "[[ -n '$WORKER_ROLE' ]]"

# =============================================================================
# Summary
# =============================================================================
echo ""
echo "=============================================="
echo "Validation Summary"
echo "=============================================="
msg "Passed: $PASSED"
if [[ $FAILED -gt 0 ]]; then
  printf "${COLOR_RED}[FAIL]${COLOR_RESET} Failed: $FAILED\n"
  echo ""
  err "Cluster validation failed with $FAILED errors"
else
  msg "All checks passed!"
  echo ""
fi
