#!/bin/bash

# EKS Terraform deployment
# Usage: ./actuate -c config/eks-demo.yaml [plan|apply|destroy]
#        ./actuate -c config/eks-demo.yaml -a apply    # auto-approve

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$(cd "$DIR" && git rev-parse --show-toplevel)/tools/common"

SRC_DIR="${DIR}/../terraform"

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------

CONFIG_FILE=""
COMMAND="apply"
AUTO_APPROVE="false"

usage() {
  echo "Usage: $0 -c <config.yaml> [-a] [plan|apply|destroy|output]"
  echo "  -c  Config file path (relative to repo root or absolute)"
  echo "  -a  Auto-approve (skip confirmation prompts)"
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--config)  CONFIG_FILE="$2"; shift 2 ;;
    -a|--auto-approve) AUTO_APPROVE="true"; shift ;;
    -h|--help)    usage ;;
    plan|apply|destroy|output) COMMAND="$1"; shift ;;
    *) err "Unknown option: $1" ;;
  esac
done

[[ -z "$CONFIG_FILE" ]] && usage
CONFIG_FILE="$(resolve_config "$CONFIG_FILE")"

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

has_tools yq terraform

DEP_ID="$(config_get "$CONFIG_FILE" deployment.id)"
DEP_REGION="$(config_get "$CONFIG_FILE" deployment.location)"
ACCOUNT_ID="$(config_get "$CONFIG_FILE" deployment.tenancy)"
BUCKET_NAME="cluster-state-${ACCOUNT_ID}"
STATE_KEY="deployments/${DEP_REGION}/${DEP_ID}/terraform.tfstate"

msg "Config:     $CONFIG_FILE"
msg "Command:    $COMMAND"
msg "Deployment: $DEP_ID"
msg "Region:     $DEP_REGION"
msg "Account:    $ACCOUNT_ID"
msg "State:      s3://$BUCKET_NAME/$STATE_KEY"

# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------

tf_init "$SRC_DIR" \
  -backend-config="bucket=$BUCKET_NAME" \
  -backend-config="region=$DEP_REGION" \
  -backend-config="encrypt=true" \
  -backend-config="key=$STATE_KEY"

case "$COMMAND" in
  plan)
    tf_plan "$SRC_DIR" "$CONFIG_FILE"
    ;;
  apply)
    tf_plan "$SRC_DIR" "$CONFIG_FILE"
    tf_apply "$SRC_DIR" "$CONFIG_FILE" "$AUTO_APPROVE"
    ;;
  destroy)
    tf_destroy "$SRC_DIR" "$CONFIG_FILE" "$AUTO_APPROVE"
    ;;
  output)
    tf_output "$SRC_DIR" "$CONFIG_FILE"
    ;;
esac

msg "Done"
