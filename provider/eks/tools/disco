#!/bin/bash

# EKS discovery tool: shows IAM identity, supported K8s versions, and add-on versions
# Usage: ./disco [-r us-west-2]

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$(cd "$DIR" && git rev-parse --show-toplevel)/tools/common"

has_tools aws jq

REGION="${AWS_DEFAULT_REGION:-us-east-1}"

while getopts "r:h" opt; do
  case $opt in
    r) REGION="$OPTARG" ;;
    h)
      echo "Usage: $0 [-r region]"
      echo "  -r region    AWS region (default: us-east-1)"
      exit 0
      ;;
    *) err "Invalid option: -$OPTARG" ;;
  esac
done

echo "[INFO] Discovering EKS information in region: ${REGION}"
echo ""

# =============================================================================
# Current IAM Identity
# =============================================================================
echo "Current IAM Identity:"
echo "---------------------"

CALLER_IDENTITY=$(aws sts get-caller-identity --output json 2>/dev/null)
ACCOUNT_ID=$(echo "$CALLER_IDENTITY" | jq -r '.Account')
USER_ARN=$(echo "$CALLER_IDENTITY" | jq -r '.Arn')

echo "  Account:  $ACCOUNT_ID"
echo "  ARN:      $USER_ARN"

if [[ "$USER_ARN" == *":assumed-role/"* ]]; then
  ROLE_NAME=$(echo "$USER_ARN" | sed 's|.*:assumed-role/\([^/]*\)/.*|\1|')
  echo "  Role:     $ROLE_NAME"
  if [[ "$ROLE_NAME" == AWSReservedSSO_* ]]; then
    echo "  Type:     AWS SSO (auto-detected)"
  fi
  echo ""
  echo "  [TIP] Add this to your config for admin access:"
  echo "        cluster:"
  echo "          adminRoles:"
  echo "            - $ROLE_NAME"
elif [[ "$USER_ARN" == *":user/"* ]]; then
  USER_NAME=$(echo "$USER_ARN" | sed 's|.*:user/||')
  echo "  User:     $USER_NAME"
  echo ""
  echo "  [TIP] IAM users don't need adminRoles config - use IAM access entries directly"
elif [[ "$USER_ARN" == *":role/"* ]]; then
  ROLE_NAME=$(echo "$USER_ARN" | sed 's|.*:role/||')
  echo "  Role:     $ROLE_NAME"
  echo ""
  echo "  [TIP] Add this to your config for admin access:"
  echo "        cluster:"
  echo "          adminRoles:"
  echo "            - $ROLE_NAME"
fi

echo ""

# =============================================================================
# Supported Kubernetes Versions
# =============================================================================
echo "Supported Kubernetes Versions:"
echo "------------------------------"

K8S_VERSIONS=$(aws eks describe-addon-versions \
  --region "$REGION" \
  --addon-name kube-proxy \
  --query 'addons[0].addonVersions[*].compatibilities[*].clusterVersion' \
  --output text 2>/dev/null | tr '\t' '\n' | sort -Vru)

for version in $K8S_VERSIONS; do
  echo "  - $version"
done

echo ""

# =============================================================================
# Add-on Versions
# =============================================================================
ADDONS=(
  "coredns"
  "vpc-cni"
  "kube-proxy"
  "amazon-cloudwatch-observability"
  "metrics-server"
  "aws-ebs-csi-driver"
)

echo "Available Add-on Versions:"
echo "--------------------------"

for addon in "${ADDONS[@]}"; do
  echo ""
  echo "  ${addon}:"

  VERSIONS=$(aws eks describe-addon-versions \
    --region "$REGION" \
    --addon-name "$addon" \
    --query 'addons[0].addonVersions[0:5].addonVersion' \
    --output text 2>/dev/null | tr '\t' '\n')

  if [[ -z "$VERSIONS" ]]; then
    echo "    (not available in this region)"
  else
    for v in $VERSIONS; do
      echo "    - $v"
    done
  fi
done

echo ""
echo "[INFO] Done"
