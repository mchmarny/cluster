#!/bin/bash

# Deploy or destroy GKE cluster via Terraform.
# Usage: actuate -c <config-file> [plan|apply|destroy]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$(cd "$SCRIPT_DIR" && git rev-parse --show-toplevel)/tools/common"

REQUIRED_TOOLS=(terraform yq gcloud)
TF_DIR="${SCRIPT_DIR}/../terraform"

usage() {
  echo "Usage: $(basename "$0") -c <config-file> [plan|apply|destroy]" >&2
  exit 1
}

# Parse flags
CONFIG_FILE=""
while getopts "c:h" opt; do
  case $opt in
    c) CONFIG_FILE="$OPTARG" ;;
    h) usage ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
ACTION="${1:-apply}"

[[ -z "$CONFIG_FILE" ]] && usage

# Validate
has_tools "${REQUIRED_TOOLS[@]}"
CONFIG_FILE=$(resolve_config "$CONFIG_FILE")
validate_config "$CONFIG_FILE"

# Read config
DEP_ID=$(config_get "$CONFIG_FILE" "deployment.id")
REGION=$(config_get "$CONFIG_FILE" "deployment.location")
PROJECT_ID=$(config_get "$CONFIG_FILE" "deployment.tenancy")
CLUSTER_NAME=$(config_get "$CONFIG_FILE" "cluster.name" "$DEP_ID")
DESTROY=$(config_get "$CONFIG_FILE" "deployment.destroy" "false")
BUCKET_NAME="cluster-state-${PROJECT_ID}"
STATE_PREFIX="deployments/${REGION}/${DEP_ID}"

msg "GKE Actuate ($ACTION)"
msg "  Project:    $PROJECT_ID"
msg "  Region:     $REGION"
msg "  Deployment: $DEP_ID"
msg "  Cluster:    $CLUSTER_NAME"

# Initialize Terraform with GCS backend
tf_init "$TF_DIR" \
  -backend-config="bucket=${BUCKET_NAME}" \
  -backend-config="prefix=${STATE_PREFIX}"

case "$ACTION" in
  plan)
    tf_plan "$TF_DIR" "$CONFIG_FILE"
    msg "Plan saved to $TF_DIR/plan.cache"
    ;;
  apply)
    if [[ "$DESTROY" == "true" ]]; then
      warn "deployment.destroy is true — destroying infrastructure"
      read -rp "Type 'yes' to confirm destroy: " confirm
      [[ "$confirm" != "yes" ]] && err "Aborted."
      tf_destroy "$TF_DIR" "$CONFIG_FILE"
    else
      tf_plan "$TF_DIR" "$CONFIG_FILE"
      tf_apply "$TF_DIR" "$CONFIG_FILE"
    fi

    # Update kubeconfig
    if [[ "$DESTROY" != "true" ]]; then
      msg "Updating kubeconfig..."
      gcloud container clusters get-credentials "$CLUSTER_NAME" \
        --region "$REGION" \
        --project "$PROJECT_ID"
    fi
    ;;
  destroy)
    read -rp "Type 'yes' to confirm destroy: " confirm
    [[ "$confirm" != "yes" ]] && err "Aborted."
    tf_destroy "$TF_DIR" "$CONFIG_FILE"
    ;;
  *)
    err "Unknown action: $ACTION (expected: plan, apply, destroy)"
    ;;
esac

msg "Done."
