#!/bin/bash

# Add current egress IP to GKE master authorized networks
# Usage: ./authcidr -c config/gke-min-gpu.yaml

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$(cd "$SCRIPT_DIR" && git rev-parse --show-toplevel)/tools/common"

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------

CONFIG_FILE=""

usage() {
  echo "Usage: $0 -c <config.yaml>"
  echo "  -c  Config file path (relative to repo root or absolute)"
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--config)  CONFIG_FILE="$2"; shift 2 ;;
    -h|--help)    usage ;;
    *) err "Unknown option: $1" ;;
  esac
done

[[ -z "$CONFIG_FILE" ]] && usage
CONFIG_FILE="$(resolve_config "$CONFIG_FILE")"

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

has_tools gcloud curl yq

validate_config "$CONFIG_FILE"

DEP_ID="$(config_get "$CONFIG_FILE" deployment.id)"
REGION="$(config_get "$CONFIG_FILE" deployment.location)"
PROJECT_ID="$(config_get "$CONFIG_FILE" deployment.tenancy)"
CLUSTER_NAME="$(config_get "$CONFIG_FILE" cluster.gke.name "$DEP_ID")"

# ---------------------------------------------------------------------------
# Detect egress IP
# ---------------------------------------------------------------------------

msg "Detecting egress IP..."
EGRESS_IP="$(curl -s https://checkip.amazonaws.com | tr -d '[:space:]')"
[[ -z "$EGRESS_IP" ]] && err "Failed to detect egress IP"
NEW_CIDR="${EGRESS_IP}/32"
msg "Egress IP: ${NEW_CIDR}"

# ---------------------------------------------------------------------------
# Get existing authorized CIDRs
# ---------------------------------------------------------------------------

msg "Reading authorized networks from cluster: ${CLUSTER_NAME}"
EXISTING=$(gcloud container clusters describe "$CLUSTER_NAME" \
  --region "$REGION" --project "$PROJECT_ID" \
  --format='value(masterAuthorizedNetworksConfig.cidrBlocks.map().cidrBlock)' 2>/dev/null | tr ';' ',')

if [[ -z "$EXISTING" ]]; then
  err "Failed to read existing authorized networks (cluster may not exist)"
fi

# Check if already authorized
if echo "$EXISTING" | tr ',' '\n' | grep -qF "$NEW_CIDR"; then
  msg "CIDR ${NEW_CIDR} is already authorized"
  exit 0
fi

msg "Existing CIDRs: ${EXISTING}"

# ---------------------------------------------------------------------------
# Update authorized networks
# ---------------------------------------------------------------------------

msg "Adding ${NEW_CIDR} to authorized networks..."
gcloud container clusters update "$CLUSTER_NAME" \
  --region "$REGION" --project "$PROJECT_ID" \
  --enable-master-authorized-networks \
  --master-authorized-networks "${EXISTING},${NEW_CIDR}" \
  --quiet

msg "Done. Authorized networks updated."
