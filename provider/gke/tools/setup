#!/bin/bash

# Bootstrap GCP project for GKE cluster deployment.
# Creates: GCS state bucket, backend.hcl, service account with IAM roles.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$(cd "$SCRIPT_DIR" && git rev-parse --show-toplevel)/tools/common"

REQUIRED_TOOLS=(gcloud yq jq)
TF_DIR="${SCRIPT_DIR}/../terraform"

usage() {
  echo "Usage: $(basename "$0") -c <config-file>" >&2
  exit 1
}

# Parse flags
CONFIG_FILE=""
while getopts "c:h" opt; do
  case $opt in
    c) CONFIG_FILE="$OPTARG" ;;
    h) usage ;;
    *) usage ;;
  esac
done

[[ -z "$CONFIG_FILE" ]] && usage

# Validate
has_tools "${REQUIRED_TOOLS[@]}"
CONFIG_FILE=$(resolve_config "$CONFIG_FILE")
validate_config "$CONFIG_FILE"

# Read config
PROJECT_ID=$(config_get "$CONFIG_FILE" "deployment.tenancy")
REGION=$(config_get "$CONFIG_FILE" "deployment.location")
DEP_ID=$(config_get "$CONFIG_FILE" "deployment.id")
SA_NAME="${DEP_ID}-builder-sa"
BUCKET_NAME="cluster-state-${PROJECT_ID}"
STATE_PREFIX="deployments/${REGION}/${DEP_ID}"

# Validate active project matches config
ACTIVE_PROJECT=$(gcloud config get-value project 2>/dev/null)
if [[ "$ACTIVE_PROJECT" != "$PROJECT_ID" ]]; then
  err "Active GCP project ($ACTIVE_PROJECT) does not match config ($PROJECT_ID). Run: gcloud config set project $PROJECT_ID"
fi

msg "GKE Setup"
msg "  Project:    $PROJECT_ID"
msg "  Region:     $REGION"
msg "  Deployment: $DEP_ID"
msg "  Bucket:     $BUCKET_NAME"
msg "  SA:         $SA_NAME"

# Check for stale Terraform state
if [[ -d "$TF_DIR/.terraform" ]] || [[ -f "$TF_DIR/.terraform.lock.hcl" ]]; then
  err "Stale Terraform state found in $TF_DIR. Remove .terraform/ and .terraform.lock.hcl before running setup."
fi

# ---------------------------------------------------------------------------
# Enable Required APIs
# ---------------------------------------------------------------------------
msg "Enabling required APIs..."

REQUIRED_APIS=(
  container.googleapis.com
  compute.googleapis.com
  iam.googleapis.com
  cloudresourcemanager.googleapis.com
  cloudkms.googleapis.com
  logging.googleapis.com
  monitoring.googleapis.com
)

ENABLED_APIS=$(gcloud services list --enabled --format="value(config.name)" --project="$PROJECT_ID" 2>/dev/null)

for api in "${REQUIRED_APIS[@]}"; do
  if echo "$ENABLED_APIS" | grep -q "^${api}$"; then
    msg "  Already enabled: $api"
  else
    msg "  Enabling: $api"
    gcloud services enable "$api" --project="$PROJECT_ID"
  fi
done

# ---------------------------------------------------------------------------
# State Bucket
# ---------------------------------------------------------------------------
msg "Configuring state bucket: $BUCKET_NAME"

if gcloud storage buckets describe "gs://$BUCKET_NAME" --project="$PROJECT_ID" &>/dev/null; then
  msg "  Bucket already exists"
else
  msg "  Creating bucket..."
  gcloud storage buckets create "gs://$BUCKET_NAME" \
    --project="$PROJECT_ID" \
    --location="$REGION" \
    --uniform-bucket-level-access \
    --public-access-prevention
fi

# Enable versioning
gcloud storage buckets update "gs://$BUCKET_NAME" --versioning

# Write backend.hcl
msg "  Writing backend.hcl"
cat > "$TF_DIR/backend.hcl" <<EOF
bucket = "$BUCKET_NAME"
prefix = "$STATE_PREFIX"
EOF

# ---------------------------------------------------------------------------
# Service Account
# ---------------------------------------------------------------------------
msg "Configuring service account: $SA_NAME"

SA_EMAIL="${SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"

if gcloud iam service-accounts describe "$SA_EMAIL" --project="$PROJECT_ID" &>/dev/null; then
  msg "  SA already exists"
else
  msg "  Creating SA..."
  gcloud iam service-accounts create "$SA_NAME" \
    --display-name="Cluster builder for ${DEP_ID}" \
    --project="$PROJECT_ID"
fi

# IAM roles for the builder SA
SA_ROLES=(
  roles/container.admin
  roles/compute.admin
  roles/iam.serviceAccountAdmin
  roles/iam.serviceAccountUser
  roles/resourcemanager.projectIamAdmin
  roles/storage.admin
  roles/cloudkms.admin
  roles/logging.admin
  roles/monitoring.admin
  roles/serviceusage.serviceUsageAdmin
)

for role in "${SA_ROLES[@]}"; do
  msg "  Binding: $role"
  gcloud projects add-iam-policy-binding "$PROJECT_ID" \
    --member="serviceAccount:$SA_EMAIL" \
    --role="$role" \
    --condition=None \
    --quiet &>/dev/null
done

msg "Setup complete."
msg ""
msg "Next steps:"
msg "  1. Authenticate: gcloud auth application-default login"
msg "  2. Deploy:       provider/gke/tools/actuate -c $CONFIG_FILE apply"
