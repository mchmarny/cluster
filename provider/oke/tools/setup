#!/bin/bash

# Bootstrap OCI tenancy for OKE cluster deployment.
# Creates: Object Storage bucket for Terraform state (Terraform's native oci
# backend) and writes backend.hcl. Authentication uses ~/.oci/config; set
# OCI_AUTH (e.g. SecurityToken) and OCI_CONFIG_FILE_PROFILE to select the
# method and profile — the same variables the terraform oci provider reads.

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$(CDPATH= cd -- "$SCRIPT_DIR" && git rev-parse --show-toplevel)/tools/common"

REQUIRED_TOOLS=(oci yq jq)
TF_DIR="${SCRIPT_DIR}/../terraform"

# State bucket name (must match pkg/oci/config.go).
STATE_BUCKET="cluster-state"

usage() {
  echo "Usage: $(basename "$0") -c <config-file>" >&2
  exit 1
}

CONFIG_FILE=""
while getopts "c:h" opt; do
  case $opt in
    c) CONFIG_FILE="$OPTARG" ;;
    h) usage ;;
    *) usage ;;
  esac
done

[[ -z "$CONFIG_FILE" ]] && usage

has_tools "${REQUIRED_TOOLS[@]}"
CONFIG_FILE=$(resolve_config "$CONFIG_FILE")
validate_config "$CONFIG_FILE"

# Single auth contract: OCI_AUTH / OCI_CONFIG_FILE_PROFILE (read by terraform)
# also drive the oci CLI.
[[ -n "${OCI_CONFIG_FILE_PROFILE:-}" ]] && export OCI_CLI_PROFILE="$OCI_CONFIG_FILE_PROFILE"
if [[ -n "${OCI_AUTH:-}" ]]; then
  OCI_CLI_AUTH="$(echo "$OCI_AUTH" | sed -E 's/([a-z])([A-Z])/\1_\2/g' | tr '[:upper:]' '[:lower:]')"
  export OCI_CLI_AUTH
fi

TENANCY_OCID=$(config_get "$CONFIG_FILE" "deployment.tenancy")
REGION=$(config_get "$CONFIG_FILE" "deployment.location")
STATE_REGION=$(config_get "$CONFIG_FILE" "deployment.stateLocation" "$REGION")
DEP_ID=$(config_get "$CONFIG_FILE" "deployment.id")
COMPARTMENT_ID=$(config_get "$CONFIG_FILE" "cluster.oke.compartmentId" "$TENANCY_OCID")
STATE_KEY="deployments/${REGION}/${DEP_ID}/terraform.tfstate"

# Validate the configured tenancy matches the active OCI identity.
if ! oci iam tenancy get --tenancy-id "$TENANCY_OCID" --region "$STATE_REGION" &>/dev/null; then
  err "Cannot read tenancy $TENANCY_OCID with the active OCI profile (${OCI_CLI_PROFILE:-DEFAULT}). Check OCI_CONFIG_FILE_PROFILE / OCI_AUTH."
fi

# Object Storage namespace for this tenancy (required by the oci backend).
OS_NAMESPACE=$(oci os ns get --region "$STATE_REGION" --query 'data' --raw-output 2>/dev/null || true)
[[ -z "$OS_NAMESPACE" ]] && err "Could not resolve Object Storage namespace. Is the OCI CLI configured (~/.oci/config)?"

msg "OKE Setup"
msg "  Tenancy:      $TENANCY_OCID"
msg "  Compartment:  $COMPARTMENT_ID"
msg "  Region:       $REGION"
msg "  State region: $STATE_REGION"
msg "  Deployment:   $DEP_ID"
msg "  Namespace:    $OS_NAMESPACE"
msg "  Bucket:       $STATE_BUCKET"

# Check for stale Terraform state.
if [[ -d "$TF_DIR/.terraform" ]] || [[ -f "$TF_DIR/.terraform.lock.hcl" ]]; then
  err "Stale Terraform state found in $TF_DIR. Remove .terraform/ and .terraform.lock.hcl before running setup."
fi

# ---------------------------------------------------------------------------
# State bucket
# ---------------------------------------------------------------------------
# Bucket names are unique per namespace, which a shared tenancy shares across
# teams; only reuse an existing bucket if it lives in the target compartment.
msg "Configuring state bucket: $STATE_BUCKET"
BUCKET_COMPARTMENT=$(oci os bucket get --bucket-name "$STATE_BUCKET" --namespace "$OS_NAMESPACE" \
  --region "$STATE_REGION" --query 'data."compartment-id"' --raw-output 2>/dev/null || true)
if [[ -n "$BUCKET_COMPARTMENT" ]]; then
  [[ "$BUCKET_COMPARTMENT" != "$COMPARTMENT_ID" ]] && \
    err "Bucket $STATE_BUCKET exists in another compartment ($BUCKET_COMPARTMENT); refusing to share state with it."
  msg "  Bucket already exists"
else
  msg "  Creating bucket..."
  oci os bucket create \
    --name "$STATE_BUCKET" \
    --namespace "$OS_NAMESPACE" \
    --compartment-id "$COMPARTMENT_ID" \
    --region "$STATE_REGION" \
    --versioning Enabled \
    --public-access-type NoPublicAccess >/dev/null
fi

# ---------------------------------------------------------------------------
# Backend config
# ---------------------------------------------------------------------------
msg "Writing backend.hcl"
cat > "$TF_DIR/backend.hcl" <<EOF
bucket    = "$STATE_BUCKET"
namespace = "$OS_NAMESPACE"
region    = "$STATE_REGION"
key       = "$STATE_KEY"
EOF

msg "Setup complete."
msg ""
msg "Next steps:"
msg "  1. Export the namespace (the cluster CLI and actuate read it for the state backend):"
msg "       export OCI_NAMESPACE=$OS_NAMESPACE"
msg "  2. Select OCI auth for terraform (defaults: ApiKey, DEFAULT profile), e.g.:"
msg "       export OCI_AUTH=SecurityToken OCI_CONFIG_FILE_PROFILE=<profile>"
msg "  3. Deploy: docker run --rm -e CONFIG_CONTENT -e OCI_NAMESPACE -e OCI_AUTH -e OCI_CONFIG_FILE_PROFILE \\"
msg "       -v \$HOME/.oci:/home/builder/.oci:ro ghcr.io/mchmarny/cluster/oke:latest apply"
