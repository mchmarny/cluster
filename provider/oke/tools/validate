#!/bin/bash
set -euo pipefail

# Post-deployment validation of OKE cluster
# Usage: ./validate -c config/oke-demo.yaml

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$(cd "$SCRIPT_DIR" && git rev-parse --show-toplevel)/tools/common"

CONFIG_FILE=""

usage() {
  echo "Usage: $0 -c <config.yaml>"
  echo "  -c  Config file path (relative to repo root or absolute)"
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--config)  CONFIG_FILE="$2"; shift 2 ;;
    -h|--help)    usage ;;
    *) err "Unknown option: $1" ;;
  esac
done

[[ -z "$CONFIG_FILE" ]] && usage
CONFIG_FILE="$(resolve_config "$CONFIG_FILE")"

has_tools oci kubectl yq jq

validate_config "$CONFIG_FILE"

DEP_ID="$(config_get "$CONFIG_FILE" deployment.id)"
REGION="$(config_get "$CONFIG_FILE" deployment.location)"
TENANCY_OCID="$(config_get "$CONFIG_FILE" deployment.tenancy)"
CLUSTER_NAME="$(config_get "$CONFIG_FILE" cluster.oke.name "$DEP_ID")"
COMPARTMENT_ID="$(config_get "$CONFIG_FILE" cluster.oke.compartmentId "$TENANCY_OCID")"
EXPECTED_VERSION="$(config_get "$CONFIG_FILE" cluster.oke.version "")"
WORKER_COUNT="$(yq '.compute.oke.nodePools.workers | length' "$CONFIG_FILE" 2>/dev/null || echo "0")"

msg "Validating cluster: ${CLUSTER_NAME} in ${REGION} (compartment: ${COMPARTMENT_ID})"

FAILED=0
PASSED=0

check() {
  local desc="$1"; shift
  if eval "$@" &>/dev/null; then
    msg "  PASS: $desc"
    PASSED=$((PASSED + 1))
  else
    printf "${COLOR_RED}  FAIL: %s${COLOR_RESET}\n" "$desc" >&2
    FAILED=$((FAILED + 1))
  fi
}

# =============================================================================
# Cluster Validation
# =============================================================================
msg "Checking OKE cluster..."

CLUSTERS_JSON=$(oci ce cluster list --compartment-id "$COMPARTMENT_ID" \
  --name "$CLUSTER_NAME" --lifecycle-state ACTIVE -o json 2>/dev/null || echo "{}")

CLUSTER_ID=$(echo "$CLUSTERS_JSON" | jq -r '.data[0].id // ""' 2>/dev/null || echo "")

if [[ -z "$CLUSTER_ID" ]]; then
  err "Active cluster '$CLUSTER_NAME' not found in compartment '$COMPARTMENT_ID'"
fi

CLUSTER_JSON=$(oci ce cluster get --cluster-id "$CLUSTER_ID" -o json 2>/dev/null || echo "{}")

LIFECYCLE_STATE=$(echo "$CLUSTER_JSON" | jq -r '.data."lifecycle-state"')
CLUSTER_VERSION=$(echo "$CLUSTER_JSON" | jq -r '.data."kubernetes-version"')
PUBLIC_ENDPOINT=$(echo "$CLUSTER_JSON" | jq -r '.data.endpoints."public-endpoint" // ""')
PRIVATE_ENDPOINT=$(echo "$CLUSTER_JSON" | jq -r '.data.endpoints."private-endpoint" // ""')

check "Cluster lifecycle state is ACTIVE" "[[ '$LIFECYCLE_STATE' == 'ACTIVE' ]]"
check "Cluster has a private endpoint" "[[ -n '$PRIVATE_ENDPOINT' ]]"
check "Cluster has no public endpoint (private by default)" "[[ -z '$PUBLIC_ENDPOINT' ]]"

if [[ -n "$EXPECTED_VERSION" ]]; then
  check "Cluster version matches $EXPECTED_VERSION" "[[ '$CLUSTER_VERSION' == ${EXPECTED_VERSION}* ]]"
fi

# =============================================================================
# Network Validation
# =============================================================================
msg "Checking network configuration..."

VCN_ID=$(echo "$CLUSTER_JSON" | jq -r '.data."vcn-id" // ""')
check "Cluster is attached to a VCN" "[[ -n '$VCN_ID' ]]"

if [[ -n "$VCN_ID" ]]; then
  SUBNET_COUNT=$(oci network subnet list --compartment-id "$COMPARTMENT_ID" --vcn-id "$VCN_ID" \
    --query 'length(data)' --raw-output 2>/dev/null || echo "0")
  check "VCN has >= 2 subnets" "[[ $SUBNET_COUNT -ge 2 ]]"
fi

# =============================================================================
# Node Pool Validation
# =============================================================================
msg "Checking node pools..."

POOLS_JSON=$(oci ce node-pool list --compartment-id "$COMPARTMENT_ID" --cluster-id "$CLUSTER_ID" -o json 2>/dev/null || echo "{}")
POOL_NAMES=$(echo "$POOLS_JSON" | jq -r '.data[].name' 2>/dev/null || echo "")
POOL_COUNT=$(echo "$POOL_NAMES" | grep -c . || echo "0")
EXPECTED_POOL_COUNT=$(( WORKER_COUNT + 1 ))

check "System node pool exists" "echo '$POOL_NAMES' | grep -q 'system'"
check "Node pool count matches config (expected $EXPECTED_POOL_COUNT)" "[[ $POOL_COUNT -eq $EXPECTED_POOL_COUNT ]]"

# =============================================================================
# Node Validation
# =============================================================================
msg "Checking nodes..."

KUBECONFIG_TMP="$(mktemp)"
trap 'rm -f "$KUBECONFIG_TMP"' EXIT
oci ce cluster create-kubeconfig --cluster-id "$CLUSTER_ID" --file "$KUBECONFIG_TMP" \
  --region "$REGION" --token-version 2.0.0 --kube-endpoint PRIVATE_ENDPOINT &>/dev/null || \
  warn "Could not fetch kubeconfig (private endpoint may require in-network access)"

NODE_COUNT=$(KUBECONFIG="$KUBECONFIG_TMP" kubectl get nodes --no-headers 2>/dev/null | wc -l | tr -d ' ' || echo "0")
READY_NODES=$(KUBECONFIG="$KUBECONFIG_TMP" kubectl get nodes --no-headers 2>/dev/null | grep -c " Ready " || echo "0")

check "At least 1 node exists" "[[ $NODE_COUNT -ge 1 ]]"
check "All nodes are Ready" "[[ $READY_NODES -eq $NODE_COUNT && $NODE_COUNT -gt 0 ]]"

# =============================================================================
# Summary
# =============================================================================
echo ""
echo "=============================================="
echo "Validation Summary"
echo "=============================================="
msg "Passed: $PASSED"
if [[ $FAILED -gt 0 ]]; then
  printf "${COLOR_RED}Failed: %s${COLOR_RESET}\n" "$FAILED" >&2
  echo ""
  err "Cluster validation failed with $FAILED errors"
else
  msg "All checks passed!"
  echo ""
fi
