{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mchmarny/cluster/schema/cluster-config.schema.json",
  "title": "Cluster Config (base)",
  "description": "Shared base schema for cluster deployment configuration",
  "$defs": {
    "deployment": {
      "type": "object",
      "required": ["id", "provider", "tenancy", "location"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique deployment identifier"
        },
        "provider": {
          "type": "string",
          "enum": ["eks", "gke"],
          "description": "Cloud provider (eks, gke)"
        },
        "tenancy": {
          "type": "string",
          "description": "Cloud account/subscription/project ID"
        },
        "location": {
          "type": "string",
          "description": "Cloud region (e.g. us-west-2, us-central1)"
        },
        "state": {
          "type": "string",
          "enum": ["tenancy", "local"],
          "default": "tenancy",
          "description": "Terraform state backend: 'tenancy' for cloud storage, 'local' for local tfstate"
        },
        "destroy": {
          "type": "boolean",
          "default": false,
          "description": "Set to true to destroy the cluster"
        },
        "tags": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Key-value tags applied to all resources"
        }
      }
    }
  }
}
