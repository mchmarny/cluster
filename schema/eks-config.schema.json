{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mchmarny/cluster/schema/eks-config.schema.json",
  "title": "EKS Cluster Config",
  "description": "Schema for EKS cluster deployment configuration",
  "type": "object",
  "required": ["apiVersion", "kind", "deployment", "cluster"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "github.com/mchmarny/cluster/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "Cluster"
    },
    "deployment": {
      "$ref": "cluster-config.schema.json#/$defs/deployment"
    },
    "cluster": {
      "type": "object",
      "required": ["eks"],
      "additionalProperties": false,
      "properties": {
        "eks": {
          "type": "object",
          "required": ["version"],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "description": "Kubernetes version (e.g. 1.35)"
            },
            "name": {
              "type": "string",
              "description": "Cluster name (defaults to deployment.id)"
            },
            "adminRoles": {
              "type": "array",
              "items": { "type": "string" },
              "description": "IAM roles granted cluster admin access"
            },
            "controlPlane": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allowedCidrs": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "CIDRs allowed to access the API server (your egress IP is auto-added)"
                },
                "cidr": {
                  "type": "string",
                  "description": "Service CIDR for the control plane"
                }
              }
            },
            "addOns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "coreDns": {
                  "type": "string",
                  "description": "CoreDNS add-on version (empty for latest)"
                },
                "vpcCni": {
                  "type": "string",
                  "description": "VPC CNI add-on version (empty for latest). Enables custom networking: secondary CIDR, pod subnets, pod SG, and ENIConfig. Omit to disable."
                },
                "kubeProxy": {
                  "type": "string",
                  "description": "kube-proxy add-on version (empty for latest)"
                },
                "cloudwatchObservability": {
                  "type": "string",
                  "description": "CloudWatch Observability add-on version (empty for latest)"
                },
                "ebsCsi": {
                  "type": "string",
                  "description": "EBS CSI driver add-on version (empty for latest)"
                },
                "metricsServer": {
                  "type": "string",
                  "description": "Metrics Server add-on version (empty for latest)"
                }
              }
            }
          }
        }
      }
    },
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sshPublicKey": {
              "type": "string",
              "description": "SSH public key for node access"
            },
            "nodeGroups": {
              "type": "object",
              "required": ["system"],
              "additionalProperties": false,
              "properties": {
                "system": {
                  "type": "object",
                  "required": ["instanceType", "capacity"],
                  "additionalProperties": false,
                  "description": "EKS managed node group (AL2023) — no custom AMI or capacity reservations",
                  "properties": {
                    "instanceType": {
                      "type": "string",
                      "description": "EC2 instance type for system nodes"
                    },
                    "capacity": { "$ref": "#/$defs/capacity" },
                    "labels": {
                      "type": "object",
                      "additionalProperties": { "type": "string" },
                      "description": "Kubernetes node labels"
                    },
                    "taints": { "$ref": "#/$defs/taints" }
                  }
                },
                "workers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "instanceType", "capacity"],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Worker node group name"
                      },
                      "instanceType": {
                        "type": "string",
                        "description": "EC2 instance type"
                      },
                      "gpuType": {
                        "type": "string",
                        "description": "GPU type (e.g. a100, h100)"
                      },
                      "architecture": {
                        "type": "string",
                        "enum": ["x86_64", "arm64"],
                        "description": "CPU architecture (default: x86_64)"
                      },
                      "accelerator": {
                        "type": "string",
                        "description": "EFA accelerator type (auto-derived from instanceType: p5->h100, p6->gb200). Set only to override."
                      },
                      "imageId": {
                        "type": "string",
                        "description": "Custom AMI ID"
                      },
                      "capacity": { "$ref": "#/$defs/capacity" },
                      "labels": {
                        "type": "object",
                        "additionalProperties": { "type": "string" },
                        "description": "Kubernetes node labels"
                      },
                      "taints": { "$ref": "#/$defs/taints" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "host": {
                  "type": "string",
                  "description": "VPC CIDR block (default: 10.0.0.0/16)"
                },
                "pod": {
                  "type": "string",
                  "description": "Pod CIDR block (default: 100.65.0.0/16). Only used when vpcCni add-on is enabled."
                }
              }
            },
            "securityGroups": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "additionalRules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["target", "direction", "fromPort", "toPort", "protocol"],
                    "additionalProperties": false,
                    "properties": {
                      "target": {
                        "type": "string",
                        "enum": ["system", "worker", "pod"],
                        "description": "Security group to add the rule to"
                      },
                      "direction": {
                        "type": "string",
                        "enum": ["ingress", "egress"],
                        "description": "Rule direction"
                      },
                      "description": {
                        "type": "string",
                        "description": "Rule description"
                      },
                      "fromPort": {
                        "type": "integer",
                        "description": "Start port"
                      },
                      "toPort": {
                        "type": "integer",
                        "description": "End port"
                      },
                      "protocol": {
                        "type": "string",
                        "description": "Protocol (tcp, udp, -1 for all)"
                      },
                      "cidrBlocks": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "CIDR blocks for the rule"
                      }
                    }
                  }
                }
              }
            },
            "subnets": {
              "type": "object",
              "description": "Subnet definitions by tier (public, system, worker, pod). Auto-computed from VPC CIDR if omitted.",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "cidr": { "type": "string" },
                    "zone": { "type": "string" },
                    "disableEndpoints": {
                      "type": "boolean",
                      "description": "Disable VPC endpoints for this subnet"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "iam": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "systemNodePolicies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional IAM policy ARNs to attach to system node role"
        },
        "workerNodePolicies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional IAM policy ARNs to attach to worker node role"
        }
      }
    }
  },
  "$defs": {
    "taints": {
      "type": "array",
      "description": "Additional node taints, appended to the default dedicated taints for the node group",
      "items": {
        "type": "object",
        "required": ["key", "value", "effect"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "value": { "type": "string" },
          "effect": {
            "type": "string",
            "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"]
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "required": ["desired"],
      "additionalProperties": false,
      "properties": {
        "desired": {
          "type": "integer",
          "minimum": 0,
          "description": "Desired node count"
        },
        "min": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum node count for autoscaling"
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum node count for autoscaling"
        },
        "reservation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preference": {
              "type": "string",
              "description": "Capacity reservation preference (e.g. capacity-reservations-only)"
            },
            "target": {
              "type": "string",
              "description": "Capacity reservation ID, resource group ARN, or resource group name"
            },
            "marketType": {
              "type": "string",
              "description": "Market type (e.g. capacity-block)"
            }
          }
        }
      }
    }
  }
}
