{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mchmarny/cluster/schema/oke-config.schema.json",
  "title": "OKE Cluster Config",
  "description": "Schema for OKE (Oracle Container Engine for Kubernetes) cluster deployment configuration",
  "type": "object",
  "required": ["apiVersion", "kind", "deployment", "cluster"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "github.com/mchmarny/cluster/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "Cluster"
    },
    "deployment": {
      "$ref": "cluster-config.schema.json#/$defs/deployment"
    },
    "cluster": {
      "type": "object",
      "required": ["oke"],
      "additionalProperties": false,
      "properties": {
        "oke": {
          "type": "object",
          "required": ["version"],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "description": "Kubernetes version, OCI format (e.g. v1.33.1)"
            },
            "name": {
              "type": "string",
              "description": "Cluster name (defaults to deployment.id)"
            },
            "compartmentId": {
              "type": "string",
              "description": "Compartment OCID for cluster resources (defaults to tenancy/root)"
            },
            "controlPlane": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "isPublicIpEnabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Assign a public IP to the API server endpoint"
                },
                "allowedCidrs": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "CIDRs allowed to reach the API server (terraform executor IP is auto-added)"
                }
              }
            }
          }
        }
      }
    },
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oke": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodePools": {
              "type": "object",
              "required": ["system"],
              "additionalProperties": false,
              "properties": {
                "system": { "$ref": "#/$defs/nodePool" },
                "workers": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      { "$ref": "#/$defs/nodePool" },
                      { "required": ["name"] }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oke": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidr": {
              "type": "string",
              "description": "VCN CIDR block (default: 10.0.0.0/16)"
            },
            "podsCidr": {
              "type": "string",
              "description": "Pod network CIDR for OCI_VCN_IP_NATIVE (default: 10.244.0.0/16)"
            },
            "servicesCidr": {
              "type": "string",
              "description": "Kubernetes service CIDR (default: 10.96.0.0/16)"
            },
            "subnets": {
              "type": "object",
              "additionalProperties": false,
              "description": "Subnet definitions. Auto-computed from VCN CIDR if omitted.",
              "properties": {
                "system": { "$ref": "#/$defs/subnet" },
                "worker": { "$ref": "#/$defs/subnet" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nodePool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Node pool name (required for worker pools)"
        },
        "shape": {
          "type": "string",
          "description": "OCI compute shape (e.g. VM.Standard.E4.Flex)"
        },
        "ocpus": {
          "type": "integer",
          "minimum": 1,
          "description": "OCPUs per node (Flex shapes only)"
        },
        "memoryGb": {
          "type": "integer",
          "minimum": 1,
          "description": "Memory in GB per node (Flex shapes only)"
        },
        "bootVolumeSizeGb": {
          "type": "integer",
          "minimum": 50,
          "description": "Boot volume size in GB"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of nodes in the pool"
        },
        "gpuType": {
          "type": "string",
          "description": "GPU accelerator type (e.g. h100); selects a GPU shape and image"
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Kubernetes node labels"
        }
      }
    },
    "subnet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cidr": {
          "type": "string",
          "description": "Subnet CIDR block"
        }
      }
    }
  }
}
