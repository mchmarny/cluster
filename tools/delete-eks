#!/bin/bash
set -euo pipefail

# Delete EKS cluster resources that Terraform may leave behind.
# Discovers most resources via the `Cluster=<prefix>` tag set by Terraform
# (provider default_tags). Falls back to VPC traversal for VPC-scoped objects.
# Usage: tools/delete-eks -x <prefix> -r <region> [-c <cluster>] [-a <account>]

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${DIR}/common"

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------

PREFIX=""
REGION=""
CLUSTER=""
ACCOUNT=""

usage() {
  echo "Usage: $0 -x <prefix> -r <region> [-c <cluster>] [-a <account>]"
  echo "  -x  Deployment prefix (deployment.id)"
  echo "  -r  AWS region"
  echo "  -c  EKS cluster name (default: <prefix>)"
  echo "  -a  AWS account ID (default: from sts get-caller-identity)"
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -x|--prefix)  PREFIX="$2"; shift 2 ;;
    -r|--region)  REGION="$2"; shift 2 ;;
    -c|--cluster) CLUSTER="$2"; shift 2 ;;
    -a|--account) ACCOUNT="$2"; shift 2 ;;
    -h|--help)    usage ;;
    *) err "Unknown option: $1" ;;
  esac
done

[[ -z "$PREFIX" ]] && err "Missing required flag: -x <prefix>"
[[ -z "$REGION" ]] && err "Missing required flag: -r <region>"
[[ -z "$CLUSTER" ]] && CLUSTER="$PREFIX"

# ---------------------------------------------------------------------------
# Setup
# ---------------------------------------------------------------------------

has_tools aws

if [[ -z "$ACCOUNT" ]]; then
  ACCOUNT=$(aws sts get-caller-identity --query Account --output text)
fi

TAG_FILTER="Key=Cluster,Values=${PREFIX}"
EC2_TAG_FILTER="Name=tag:Cluster,Values=${PREFIX}"

msg "Deleting EKS resources: prefix=${PREFIX} cluster=${CLUSTER} region=${REGION} account=${ACCOUNT}"

# ---------------------------------------------------------------------------
# 1. Capture OIDC issuer (must read before cluster delete)
# ---------------------------------------------------------------------------
OIDC_URL=$(aws eks describe-cluster --name "$CLUSTER" --region "$REGION" \
  --query 'cluster.identity.oidc.issuer' --output text 2>/dev/null || echo "")

# ---------------------------------------------------------------------------
# 2. EKS managed node group, addons, cluster
# ---------------------------------------------------------------------------
msg "Deleting EKS managed node group..."
aws eks delete-nodegroup --cluster-name "$CLUSTER" \
  --nodegroup-name "${PREFIX}-system" --region "$REGION" 2>/dev/null || true
aws eks wait nodegroup-deleted --cluster-name "$CLUSTER" \
  --nodegroup-name "${PREFIX}-system" --region "$REGION" 2>/dev/null || true

msg "Deleting EKS addons..."
for addon in coredns vpc-cni kube-proxy amazon-cloudwatch-observability metrics-server aws-ebs-csi-driver; do
  aws eks delete-addon --cluster-name "$CLUSTER" --addon-name "$addon" \
    --region "$REGION" 2>/dev/null || true
done

msg "Deleting EKS cluster..."
aws eks delete-cluster --name "$CLUSTER" --region "$REGION" 2>/dev/null || true
aws eks wait cluster-deleted --name "$CLUSTER" --region "$REGION" 2>/dev/null || true

# ---------------------------------------------------------------------------
# 3. OIDC provider
# ---------------------------------------------------------------------------
if [[ -n "$OIDC_URL" && "$OIDC_URL" != "None" ]]; then
  msg "Deleting OIDC provider..."
  OIDC_ARN="arn:aws:iam::${ACCOUNT}:oidc-provider/${OIDC_URL#https://}"
  aws iam delete-open-id-connect-provider \
    --open-id-connect-provider-arn "$OIDC_ARN" 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# 4. Auto Scaling Groups (worker self-managed node groups)
# ---------------------------------------------------------------------------
msg "Deleting Auto Scaling Groups..."
ASGS=$(aws autoscaling describe-auto-scaling-groups --region "$REGION" \
  --filters "$EC2_TAG_FILTER" \
  --query "AutoScalingGroups[].AutoScalingGroupName" \
  --output text 2>/dev/null || echo "")
for asg in $ASGS; do
  aws autoscaling delete-auto-scaling-group --auto-scaling-group-name "$asg" \
    --force-delete --region "$REGION" 2>/dev/null || true
done

# ---------------------------------------------------------------------------
# 5. Launch templates
# ---------------------------------------------------------------------------
msg "Deleting launch templates..."
LTS=$(aws ec2 describe-launch-templates --region "$REGION" \
  --filters "$EC2_TAG_FILTER" \
  --query "LaunchTemplates[].LaunchTemplateId" --output text 2>/dev/null || echo "")
for lt in $LTS; do
  aws ec2 delete-launch-template --launch-template-id "$lt" \
    --region "$REGION" 2>/dev/null || true
done

# ---------------------------------------------------------------------------
# 6. VPC-scoped network resources (anchor by VPC ID)
# ---------------------------------------------------------------------------
VPC_ID=$(aws ec2 describe-vpcs --region "$REGION" \
  --filters "$EC2_TAG_FILTER" \
  --query "Vpcs[0].VpcId" --output text 2>/dev/null || echo "None")

if [[ "$VPC_ID" != "None" && -n "$VPC_ID" ]]; then
  msg "Deleting VPC endpoints..."
  VPCES=$(aws ec2 describe-vpc-endpoints --region "$REGION" \
    --filters "Name=vpc-id,Values=$VPC_ID" \
    --query "VpcEndpoints[].VpcEndpointId" --output text 2>/dev/null || echo "")
  if [[ -n "$VPCES" ]]; then
    aws ec2 delete-vpc-endpoints --vpc-endpoint-ids $VPCES \
      --region "$REGION" 2>/dev/null || true
  fi

  msg "Deleting NAT gateways..."
  NATS=$(aws ec2 describe-nat-gateways --region "$REGION" \
    --filter "Name=vpc-id,Values=$VPC_ID" \
    --query "NatGateways[?State!=\`deleted\` && State!=\`failed\`].NatGatewayId" \
    --output text 2>/dev/null || echo "")
  for nat in $NATS; do
    aws ec2 delete-nat-gateway --nat-gateway-id "$nat" \
      --region "$REGION" 2>/dev/null || true
  done
  for nat in $NATS; do
    for _ in $(seq 1 60); do
      state=$(aws ec2 describe-nat-gateways --nat-gateway-ids "$nat" \
        --region "$REGION" --query "NatGateways[0].State" \
        --output text 2>/dev/null || echo "deleted")
      [[ "$state" == "deleted" || "$state" == "None" || "$state" == "failed" ]] && break
      sleep 10
    done
  done

  msg "Releasing EIPs..."
  EIPS=$(aws ec2 describe-addresses --region "$REGION" \
    --filters "$EC2_TAG_FILTER" \
    --query "Addresses[].AllocationId" --output text 2>/dev/null || echo "")
  for eip in $EIPS; do
    aws ec2 release-address --allocation-id "$eip" \
      --region "$REGION" 2>/dev/null || true
  done

  msg "Deleting Internet Gateway..."
  IGW=$(aws ec2 describe-internet-gateways --region "$REGION" \
    --filters "Name=attachment.vpc-id,Values=$VPC_ID" \
    --query "InternetGateways[0].InternetGatewayId" \
    --output text 2>/dev/null || echo "None")
  if [[ "$IGW" != "None" && -n "$IGW" ]]; then
    aws ec2 detach-internet-gateway --internet-gateway-id "$IGW" \
      --vpc-id "$VPC_ID" --region "$REGION" 2>/dev/null || true
    aws ec2 delete-internet-gateway --internet-gateway-id "$IGW" \
      --region "$REGION" 2>/dev/null || true
  fi

  msg "Deleting VPC flow logs..."
  FLOWS=$(aws ec2 describe-flow-logs --region "$REGION" \
    --filter "Name=resource-id,Values=$VPC_ID" \
    --query "FlowLogs[].FlowLogId" --output text 2>/dev/null || echo "")
  if [[ -n "$FLOWS" ]]; then
    aws ec2 delete-flow-logs --flow-log-ids $FLOWS \
      --region "$REGION" 2>/dev/null || true
  fi

  msg "Deleting route tables..."
  RTS=$(aws ec2 describe-route-tables --region "$REGION" \
    --filters "Name=vpc-id,Values=$VPC_ID" \
    --query "RouteTables[?length(Associations[?Main==\`true\`])==\`0\`].RouteTableId" \
    --output text 2>/dev/null || echo "")
  for rt in $RTS; do
    ASSOCS=$(aws ec2 describe-route-tables --route-table-ids "$rt" \
      --region "$REGION" \
      --query "RouteTables[0].Associations[?Main==\`false\`].RouteTableAssociationId" \
      --output text 2>/dev/null || echo "")
    for assoc in $ASSOCS; do
      aws ec2 disassociate-route-table --association-id "$assoc" \
        --region "$REGION" 2>/dev/null || true
    done
    aws ec2 delete-route-table --route-table-id "$rt" \
      --region "$REGION" 2>/dev/null || true
  done

  msg "Deleting subnets..."
  SUBS=$(aws ec2 describe-subnets --region "$REGION" \
    --filters "Name=vpc-id,Values=$VPC_ID" \
    --query "Subnets[].SubnetId" --output text 2>/dev/null || echo "")
  for sub in $SUBS; do
    aws ec2 delete-subnet --subnet-id "$sub" --region "$REGION" 2>/dev/null || true
  done

  msg "Deleting security groups..."
  SGS=$(aws ec2 describe-security-groups --region "$REGION" \
    --filters "Name=vpc-id,Values=$VPC_ID" \
    --query "SecurityGroups[?GroupName!=\`default\`].GroupId" \
    --output text 2>/dev/null || echo "")
  for sg in $SGS; do
    INGRESS=$(aws ec2 describe-security-groups --group-ids "$sg" \
      --region "$REGION" --query "SecurityGroups[0].IpPermissions" \
      --output json 2>/dev/null || echo "[]")
    if [[ "$INGRESS" != "[]" && "$INGRESS" != "null" ]]; then
      aws ec2 revoke-security-group-ingress --group-id "$sg" \
        --ip-permissions "$INGRESS" --region "$REGION" 2>/dev/null || true
    fi
    EGRESS=$(aws ec2 describe-security-groups --group-ids "$sg" \
      --region "$REGION" --query "SecurityGroups[0].IpPermissionsEgress" \
      --output json 2>/dev/null || echo "[]")
    if [[ "$EGRESS" != "[]" && "$EGRESS" != "null" ]]; then
      aws ec2 revoke-security-group-egress --group-id "$sg" \
        --ip-permissions "$EGRESS" --region "$REGION" 2>/dev/null || true
    fi
  done
  for sg in $SGS; do
    aws ec2 delete-security-group --group-id "$sg" \
      --region "$REGION" 2>/dev/null || true
  done

  msg "Disassociating secondary VPC CIDR blocks..."
  CIDR_ASSOCS=$(aws ec2 describe-vpcs --vpc-ids "$VPC_ID" --region "$REGION" \
    --query "Vpcs[0].CidrBlockAssociationSet[?CidrBlockState.State==\`associated\` && CidrBlock!=Vpcs[0].CidrBlock].AssociationId" \
    --output text 2>/dev/null || echo "")
  for a in $CIDR_ASSOCS; do
    aws ec2 disassociate-vpc-cidr-block --association-id "$a" \
      --region "$REGION" 2>/dev/null || true
  done

  msg "Deleting VPC..."
  aws ec2 delete-vpc --vpc-id "$VPC_ID" --region "$REGION" 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# 7. CloudWatch log groups
# ---------------------------------------------------------------------------
msg "Deleting log groups..."
LOG_ARNS=$(aws resourcegroupstaggingapi get-resources --region "$REGION" \
  --resource-type-filters logs:log-group --tag-filters "$TAG_FILTER" \
  --query "ResourceTagMappingList[].ResourceARN" --output text 2>/dev/null || echo "")
for arn in $LOG_ARNS; do
  # ARN: arn:aws:logs:region:account:log-group:NAME
  name="${arn#*:log-group:}"
  name="${name%%:*}"
  aws logs delete-log-group --log-group-name "$name" \
    --region "$REGION" 2>/dev/null || true
done

# ---------------------------------------------------------------------------
# 8. KMS alias + scheduled key destruction
# ---------------------------------------------------------------------------
msg "Scheduling KMS key destruction..."
KEY_ARNS=$(aws resourcegroupstaggingapi get-resources --region "$REGION" \
  --resource-type-filters kms:key --tag-filters "$TAG_FILTER" \
  --query "ResourceTagMappingList[].ResourceARN" --output text 2>/dev/null || echo "")
for arn in $KEY_ARNS; do
  key_id="${arn##*/}"
  for alias in $(aws kms list-aliases --key-id "$key_id" --region "$REGION" \
    --query "Aliases[].AliasName" --output text 2>/dev/null || echo ""); do
    aws kms delete-alias --alias-name "$alias" --region "$REGION" 2>/dev/null || true
  done
  aws kms schedule-key-deletion --key-id "$key_id" \
    --pending-window-in-days 7 --region "$REGION" 2>/dev/null || true
done

# ---------------------------------------------------------------------------
# 9. IAM roles, instance profiles, policies (discovered via tagging API)
# ---------------------------------------------------------------------------
msg "Deleting IAM instance profiles..."
PROFILE_ARNS=$(aws resourcegroupstaggingapi get-resources --region "$REGION" \
  --resource-type-filters iam:instance-profile --tag-filters "$TAG_FILTER" \
  --query "ResourceTagMappingList[].ResourceARN" --output text 2>/dev/null || echo "")
for arn in $PROFILE_ARNS; do
  name="${arn##*/}"
  ROLES=$(aws iam get-instance-profile --instance-profile-name "$name" \
    --query "InstanceProfile.Roles[].RoleName" --output text 2>/dev/null || echo "")
  for r in $ROLES; do
    aws iam remove-role-from-instance-profile \
      --instance-profile-name "$name" --role-name "$r" 2>/dev/null || true
  done
  aws iam delete-instance-profile --instance-profile-name "$name" 2>/dev/null || true
done

msg "Deleting IAM roles..."
ROLE_ARNS=$(aws resourcegroupstaggingapi get-resources --region "$REGION" \
  --resource-type-filters iam:role --tag-filters "$TAG_FILTER" \
  --query "ResourceTagMappingList[].ResourceARN" --output text 2>/dev/null || echo "")
for arn in $ROLE_ARNS; do
  role="${arn##*/}"
  ATTACHED=$(aws iam list-attached-role-policies --role-name "$role" \
    --query "AttachedPolicies[].PolicyArn" --output text 2>/dev/null || echo "")
  for p in $ATTACHED; do
    aws iam detach-role-policy --role-name "$role" \
      --policy-arn "$p" 2>/dev/null || true
  done
  INLINE=$(aws iam list-role-policies --role-name "$role" \
    --query "PolicyNames[]" --output text 2>/dev/null || echo "")
  for p in $INLINE; do
    aws iam delete-role-policy --role-name "$role" \
      --policy-name "$p" 2>/dev/null || true
  done
  aws iam delete-role --role-name "$role" 2>/dev/null || true
done

msg "Deleting custom IAM policies..."
POLICY_ARNS=$(aws resourcegroupstaggingapi get-resources --region "$REGION" \
  --resource-type-filters iam:policy --tag-filters "$TAG_FILTER" \
  --query "ResourceTagMappingList[].ResourceARN" --output text 2>/dev/null || echo "")
for arn in $POLICY_ARNS; do
  aws iam delete-policy --policy-arn "$arn" 2>/dev/null || true
done

# ---------------------------------------------------------------------------
# 10. SSH key pair
# ---------------------------------------------------------------------------
msg "Deleting SSH key pairs..."
KEYS=$(aws ec2 describe-key-pairs --region "$REGION" \
  --filters "$EC2_TAG_FILTER" \
  --query "KeyPairs[].KeyName" --output text 2>/dev/null || echo "")
for k in $KEYS; do
  aws ec2 delete-key-pair --key-name "$k" --region "$REGION" 2>/dev/null || true
done

# ---------------------------------------------------------------------------
# 11. Clean up Terraform state in S3
# ---------------------------------------------------------------------------
msg "Cleaning Terraform state from S3..."
aws s3 rm "s3://cluster-state-${ACCOUNT}/deployments/${REGION}/${PREFIX}/" \
  --recursive 2>/dev/null || true

msg "Done"
